{
  "name": "aditya-enterprises-erp",
  "version": "2.0.0",
  "description": "Aditya Enterprises ERP Suite 2026 - Inventory, Billing, GST, AI",
  "author": "Aditya Enterprises",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"node server.js\" \"cd client && npx vite\"",
    "build-client": "cd client && npx vite build",
    "setup": "npm install && cd client && npm install && npm run build",
    "electron:dev": "concurrently \"node server.js\" \"wait-on http://127.0.0.1:3000/api/health && electron .\"",
    "electron:build": "npm run build-client && electron-builder --win",
    "electron:build-portable": "npm run build-client && electron-builder --win portable",
    "electron:rebuild": "electron-builder install-app-deps",
    "node:rebuild": "npm rebuild sharp"
  },
  "dependencies": {
    "bwip-js": "^4.5.0",
    "call-bind-apply-helpers": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "groq-sdk": "^0.8.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.33.5",
    "sql.js": "^1.14.1",
    "uuid": "^10.0.0"
  },
  "optionalDependencies": {
    "serialport": "^12.0.0",
    "usb-detection": "^4.15.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.adityaenterprises.erp",
    "productName": "Aditya Enterprises ERP",
    "copyright": "Copyright 2026 Aditya Enterprises",
    "directories": {
      "output": "release"
    },
    "files": [
      "db.js",
      "routes/**/*",
      "electron/**/*",
      "client/dist/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/concurrently/**",
      "!node_modules/wait-on/**",
      "!node_modules/.cache/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "client/public/logo.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aditya Enterprises ERP",
      "installerIcon": "client/public/logo.ico",
      "uninstallerIcon": "client/public/logo.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**"
    ],
    "npmRebuild": false,
    "includeSubNodeModules": true
  }
}
