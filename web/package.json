{
  "name": "aditya-enterprises-erp-web",
  "version": "2.0.0",
  "description": "Aditya Enterprises ERP Web - Cloud ERP for Inventory, Billing, GST, AI",
  "author": "Aditya Enterprises",
  "scripts": {
    "dev": "concurrently \"node api/index.js\" \"cd client && npx vite\"",
    "dev:server": "node api/index.js",
    "dev:client": "cd client && npx vite",
    "build": "cd client && npx vite build",
    "start": "node api/index.js",
    "sync-turso": "node scripts/sync-turso.js",
    "setup": "npm install && cd client && npm install",
    "vercel-build": "cd client && npm install && npm run build"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@supabase/supabase-js": "^2.45.0",
    "bwip-js": "^4.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "groq-sdk": "^0.8.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "sharp": "^0.33.5",
    "sql.js": "^1.14.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^5.4.3"
  }
}
