# ============================================
# ArynoxTech ERP Suite 2026 - Environment Configuration
# ============================================
# Copy this file to D:\ArynoxTechERP\Config\.env and fill in your values.

# Application
APP_NAME=ArynoxTech ERP Suite 2026
COMPANY_NAME=Aditya Enterprises
VERSION=1.0.0
DEBUG=false

# Database (SQLite path)
DATABASE_URL=sqlite:///D:/ArynoxTechERP/Database/arynoxtech_erp.db

# AI Integration (Optional - Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Feature Flags
ENABLE_AI=true
ENABLE_SCHEDULER=false
ENABLE_AUTH=false
ENABLE_BACKUP=true

# Security
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=[".jpg", ".jpeg", ".png", ".webp", ".gif"]
MAX_IMAGES_PER_PRODUCT=10
